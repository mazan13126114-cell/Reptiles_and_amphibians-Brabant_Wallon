    {
        "id": "e7adde9303c34d8f",
        "type": "function",
        "z": "d23874584a8594c1",
        "name": "All Species Table",
        "func": "var counts = flow.get(\"speciesCounts\") || {};\nvar locationData = flow.get(\"locationData\") || {};\n\n// Format data for table - ALL SPECIES\nvar tableData = [];\n\n// Get all species sorted by count (descending)\nvar allSpecies = Object.entries(counts)\n    .sort(([,a], [,b]) => b - a);\n\nallSpecies.forEach(([species, count]) => {\n    var locations = locationData[species] || [];\n    var uniqueLocations = [...new Set(locations.map(l => l.location))];\n    var recentDate = locations.length > 0 ? locations[locations.length - 1].date : \"Unknown\";\n    \n    tableData.push({\n        \"Species\": species,\n        \"Observations\": count,\n        \"Locations\": uniqueLocations.slice(0, 3).join(\", \") + (uniqueLocations.length > 3 ? \"...\" : \"\"),\n        \"Recent Date\": recentDate\n    });\n});\n\nmsg.payload = tableData;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
