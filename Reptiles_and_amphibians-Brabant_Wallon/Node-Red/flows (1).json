    {
        "id": "e9c1d4ee9790614c",
        "type": "function",
        "z": "d23874584a8594c1",
        "name": "Count Species",
        "func": "var data = msg.payload;\nvar counts = {};\nvar locationData = {};\n\n// Count species occurrences and collect location data\ndata.forEach(row => {\n    var species = row.species || row.species_name || \"Unknown\";\n    counts[species] = (counts[species] || 0) + 1;\n    \n    // Store location and date info for rare species\n    if (!locationData[species]) {\n        locationData[species] = [];\n    }\n    locationData[species].push({\n        location: row.location || \"Unknown\",\n        date: row.date || \"Unknown\"\n    });\n});\n\n// Get top 10 COMMON species for chart (exclude rare species)\nvar commonSpecies = Object.entries(counts)\n    .filter(([species, count]) => count > 3) // Only species with more than 3 observations\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10);\n\nvar labels = commonSpecies.map(([species,]) => species);\nvar values = commonSpecies.map(([, count]) => count);\n\n// Find rare species (3 or fewer observations)\nvar rareSpecies = Object.entries(counts)\n    .filter(([species, count]) => count <= 3)\n    .sort(([,a], [,b]) => a - b); // Sort by count ascending\n\n// Store data for sharing between nodes\nflow.set(\"speciesCounts\", counts);\nflow.set(\"locationData\", locationData);\nflow.set(\"rareSpecies\", rareSpecies);\n\n// Format for dashboard chart node - only common species\nmsg.payload = [{\n    \"series\": [\"Species Count\"],\n    \"data\": [values],\n    \"labels\": labels\n}];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
